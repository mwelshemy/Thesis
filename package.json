{
  "name": "vs-code-ai-extension",
  "displayName": "VS Code AI Extension",
  "description": "AI-powered code understanding and navigation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vs-code-ai-extension.helloWorld",
    "onCommand:vs-code-ai-extension.askAI",
    "onCommand:vs-code-ai-extension.searchProject",
    "onCommand:vs-code-ai-extension.summarizeFile",
    "onCommand:vs-code-ai-extension.buildSearchIndex",
    "onCommand:vs-code-ai-extension.searchStats",
    "onCommand:vs-code-ai-extension.smartExplain",
    "onCommand:vs-code-ai-extension.deepAnalysis",
    "onCommand:vs-code-ai-extension.patternAnalysis",
    "onCommand:vs-code-ai-extension.analyzeSearchResults",
    "onCommand:vs-code-ai-extension.searchByLanguage",
    "onCommand:vs-code-ai-extension.clearSearchIndex"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-code-ai-extension.helloWorld",
        "title": "Hello World",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.askAI",
        "title": "Ask AI: Explain Code",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.searchProject",
        "title": "Search Project",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.summarizeFile",
        "title": "Summarize File",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.buildSearchIndex",
        "title": "Build Search Index",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.searchStats",
        "title": "Search Statistics",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.smartExplain",
        "title": "Smart Explain: With Project Context",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.deepAnalysis",
        "title": "Deep Analysis: Comprehensive Review",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.patternAnalysis",
        "title": "Pattern Analysis: Find Similar Code",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.analyzeSearchResults",
        "title": "Analyze Search Results with AI",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.searchByLanguage",
        "title": "Search by Language",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.clearSearchIndex",
        "title": "Clear Search Index",
        "category": "VS AI"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "test:integration": "jest tests/integration/ --verbose",
    "test:basic": "jest tests/integration/basic-integration.test.js --verbose",
    "test:workflows": "jest tests/integration/workflow-scenarios.test.js --verbose",
    "test:performance": "jest tests/integration/real-integration.test.js --testNamePattern=\"Performance Integration\" --verbose",
    "test:integration:real": "jest tests/integration/real-integration.test.js --verbose"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedwaleedelshemy/Thesis.git"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
