{
  "publisher": "CodeSense-Tools",
  "name": "vs-code-ai-assistant",
  "displayName": "VS Code AI Assistant",
  "description": "AI-powered code understanding, analysis, and navigation with intelligent search capabilities",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "code-analysis",
    "search",
    "productivity",
    "intellisense",
    "documentation"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "*",
    "onView:vsCodeAISidebar"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsCodeAI",
          "title": "VS AI",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "vsCodeAI": [
        {
          "id": "vsCodeAISidebar",
          "name": "AI Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vs-code-ai-extension.testAI",
        "title": "Test AI Connection",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.explainCode",
        "title": "Explain Code",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.findBugs",
        "title": "Find Bugs",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.showSidebar",
        "title": "Show AI Assistant",
        "category": "VS AI",
        "icon": "$(search)"
      },
      {
        "command": "vs-code-ai-extension.chat",
        "title": "AI Chat: Ask About Code",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.analyzeProject",
        "title": "Analyze Entire Project",
        "category": "VS AI"
      },
      {
        "command": "vs-code-ai-extension.semanticSearch",
        "title": "Semantic Search",
        "category": "VS AI"
      }
    ],
    "configuration": {
      "title": "VS AI Assistant",
      "properties": {
        "vsCodeAI.apiKey": {
          "type": "string",
          "default": "",
          "description": "Hugging Face API key for AI features"
        },
        "vsCodeAI.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild search index on file changes"
        },
        "vsCodeAI.maxSearchResults": {
          "type": "number",
          "default": 20,
          "description": "Maximum number of search results to display"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@huggingface/inference": "^2.6.0",
    "axios": "^1.4.0",
    "url-parse": "^1.5.10",
    "whatwg-url": "^15.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedwaleedelshemy/Thesis.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedwaleedelshemy/Thesis/issues"
  },
  "homepage": "https://github.com/mohamedwaleedelshemy/Thesis#readme",
  "license": "AUC",
  "author": "youssefkhaled@aucegypt.edu"
}
