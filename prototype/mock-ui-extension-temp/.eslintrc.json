{
  "root": true,
  "env": {
    "node": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": ["out/", "node_modules/", "*.js", "tests/"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}
